# ==============================================================================
# 泰山職訓 本地開發環境變數設定範例 (.env.example)
# 若希望本地開發時也直連 Cloudinary 雲端圖床，可將本檔複製為 .env 並填寫您的金鑰
# ==============================================================================

# 方式 A：直接貼上 Cloudinary Dashboard 官方提供的 CLOUDINARY_URL (最推薦)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@do3mfqhlg

# 方式 B：分開填寫三大欄位
CLOUDINARY_CLOUD_NAME=do3mfqhlg
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==============================================================================
# 本地開發必填：開啟除錯模式（正式環境請勿設定，預設即為 False）
# ==============================================================================
DEBUG=True

# ==============================================================================
# 正式環境 (Render) 必須設定的環境變數，請直接填在 Render 後台，不要寫進任何檔案
# ==============================================================================
# SECRET_KEY=<長度 50 以上的隨機字串>
# DATABASE_URL=<Render PostgreSQL 連線字串>
# CRON_SECRET_TOKEN=<隨機字串，需與 GitHub Secrets 的 CRON_SECRET_TOKEN 相同>
# DJANGO_SUPERUSER_PASSWORD=<管理員初始密碼，僅在帳號不存在時用於建立>
# DJANGO_SUPERUSER_RESET_PASSWORD=True   # 需要強制重設密碼時才設定，部署一次後移除
# TAIWANJOBS_SKIP_TLS_VERIFY=True        # 官方站台憑證異常時的應急開關，平時不要設定

# ==============================================================================
# 伺服器喚醒時自動補抓台灣就業通期別（正式環境預設開啟，通常不需設定）
# ==============================================================================
# BATCH_SYNC_ON_STARTUP=False      # 關閉喚醒自動補抓
# BATCH_SYNC_STALE_HOURS=6         # 最後同步距今超過幾小時才補抓
# BATCH_SYNC_STARTUP_DELAY=5       # 啟動後延遲幾秒再檢查
